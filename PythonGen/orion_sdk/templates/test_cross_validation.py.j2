    def test_{{ packet.name | snake_case }}(self, verbose: bool = False) -> List[TestResult]:
        """Run all cross-language tests for {{ packet.name }}."""
        results = []
        packet_name = "{{ packet.name }}"

        if verbose:
            print(f"Testing {packet_name}...")

        # 1. Python encode
        try:
            py_pkt = self._create_test_{{ packet.name | snake_case }}()
            py_encoded = py_pkt.encode().hex().upper()
            py_encode_ok = True
        except Exception as e:
            py_encoded = str(e)
            py_encode_ok = False
            if verbose:
                print(f"  Python encode failed: {e}")

        # 2. C encode
        c_encode_ok, c_encoded = self._c_encode(packet_name)
        if not c_encode_ok and verbose:
            print(f"  C encode failed: {c_encoded}")

        # 3. Compare encode outputs (Test: encode_match)
        if py_encode_ok and c_encode_ok:
            encode_match = (py_encoded == c_encoded)
            if encode_match:
                details = "C and Python encode produce identical bytes"
            else:
                details = f"Encode mismatch: C={len(c_encoded)//2}B, Py={len(py_encoded)//2}B"
                if verbose:
                    print(f"  Encode mismatch!")
                    print(f"    C:  {c_encoded[:80]}{'...' if len(c_encoded) > 80 else ''}")
                    print(f"    Py: {py_encoded[:80]}{'...' if len(py_encoded) > 80 else ''}")
        else:
            encode_match = False
            details = f"Encode failed: C={'OK' if c_encode_ok else 'FAIL'}, Py={'OK' if py_encode_ok else 'FAIL'}"

        results.append(TestResult(
            packet_name=packet_name,
            test_type="encode_match",
            passed=encode_match,
            details=details,
            c_output=c_encoded if c_encode_ok else f"ERROR: {c_encoded}",
            py_output=py_encoded if py_encode_ok else f"ERROR: {py_encoded}",
        ))

        # 4. Cross-decode: C encoded -> Python decode (Test: cross_c_to_py)
        if c_encode_ok:
            try:
                py_from_c, consumed = {{ packet.name }}.decode(bytes.fromhex(c_encoded))
                cross_c_to_py_ok = True
                cross_c_to_py_details = f"Python decoded {consumed} bytes from C"
            except Exception as e:
                cross_c_to_py_ok = False
                cross_c_to_py_details = f"Python failed to decode C bytes: {e}"
                if verbose:
                    print(f"  Cross C->Py failed: {e}")

            results.append(TestResult(
                packet_name=packet_name,
                test_type="cross_c_to_py",
                passed=cross_c_to_py_ok,
                details=cross_c_to_py_details,
            ))

        # 5. Cross-decode: Python encoded -> C decode (Test: cross_py_to_c)
        if py_encode_ok:
            c_decode_ok, c_fields = self._c_decode(packet_name, py_encoded)
            if c_decode_ok:
                cross_py_to_c_details = f"C decoded {len(c_fields)} fields from Python"
            else:
                cross_py_to_c_details = f"C failed to decode Python bytes: {c_fields.get('error', 'unknown')}"
                if verbose:
                    print(f"  Cross Py->C failed: {cross_py_to_c_details}")

            results.append(TestResult(
                packet_name=packet_name,
                test_type="cross_py_to_c",
                passed=c_decode_ok,
                details=cross_py_to_c_details,
            ))

        # 6. Decode value comparison (Test: decode_values)
        if py_encode_ok:
            c_decode_ok, c_fields = self._c_decode(packet_name, py_encoded)
            if c_decode_ok:
                try:
                    py_decoded, _ = {{ packet.name }}.decode(bytes.fromhex(py_encoded))
                    metadata = self.FIELD_METADATA.get(packet_name, [])

                    mismatches = []
                    for meta in metadata:
                        if not meta.in_c_struct:
                            continue
                        c_val = c_fields.get(meta.name)
                        if c_val is None:
                            continue

                        py_val = getattr(py_decoded, meta.name, None)
                        if py_val is None:
                            continue

                        match, mismatch_detail = self._values_match(c_val, py_val, meta)
                        if not match:
                            mismatches.append(f"{meta.name}: {mismatch_detail}")

                    if mismatches:
                        decode_values_ok = False
                        decode_values_details = "; ".join(mismatches[:5])
                        if verbose:
                            print(f"  Decode value mismatch:")
                            for m in mismatches[:5]:
                                print(f"    {m}")
                    else:
                        decode_values_ok = True
                        decode_values_details = f"All {len(metadata)} fields match"

                except Exception as e:
                    decode_values_ok = False
                    decode_values_details = f"Comparison error: {e}"

                results.append(TestResult(
                    packet_name=packet_name,
                    test_type="decode_values",
                    passed=decode_values_ok,
                    details=decode_values_details,
                ))

        # 7. Round-trip test (Test: round_trip)
        if py_encode_ok:
            try:
                # Get original values
                original_values = self._extract_field_values(py_pkt)

                # Encode then decode
                encoded = py_pkt.encode()
                decoded, consumed = {{ packet.name }}.decode(encoded)
                decoded_values = self._extract_field_values(decoded)

                # Compare values
                values_match, mismatch_details = self._compare_py_values(
                    original_values, decoded_values, packet_name
                )

                # Verify all bytes consumed
                if consumed != len(encoded):
                    values_match = False
                    mismatch_details = f"Only consumed {consumed}/{len(encoded)} bytes"

                results.append(TestResult(
                    packet_name=packet_name,
                    test_type="round_trip",
                    passed=values_match,
                    details=mismatch_details if not values_match else "Round-trip preserves all values",
                ))

            except Exception as e:
                results.append(TestResult(
                    packet_name=packet_name,
                    test_type="round_trip",
                    passed=False,
                    details=f"Round-trip error: {e}",
                ))

        return results

