    def __init__(self, harness_path: str = "./test_harness"):
        self.harness_path = harness_path
        self.results: List[TestResult] = []

        # On Windows, try .exe extension if base path doesn't exist
        if not os.path.exists(harness_path):
            if sys.platform == "win32" and os.path.exists(harness_path + ".exe"):
                self.harness_path = harness_path + ".exe"
            else:
                raise FileNotFoundError(
                    f"C test harness not found at {harness_path}. "
                    f"Compile with: gcc -o test_harness test_harness.c -I<path> -L<path> -lorion"
                )

    def _run_c_harness(self, *args) -> Tuple[bool, str]:
        """Run the C test harness with arguments."""
        try:
            result = subprocess.run(
                [self.harness_path] + list(args),
                capture_output=True,
                text=True,
                timeout=10
            )
            if result.returncode != 0:
                return False, f"Error (rc={result.returncode}): {result.stderr.strip()}"
            return True, result.stdout.strip()
        except subprocess.TimeoutExpired:
            return False, "Timeout (10s)"
        except Exception as e:
            return False, str(e)

    def _c_encode(self, packet_name: str) -> Tuple[bool, str]:
        """Encode a packet using C, return hex string."""
        ok, output = self._run_c_harness("encode", packet_name)
        if ok and "ENCODED:" in output:
            return True, output.split("ENCODED:")[1].strip()
        return False, output

    def _c_decode(self, packet_name: str, hex_bytes: str) -> Tuple[bool, Dict[str, str]]:
        """Decode hex bytes using C, return field values."""
        ok, output = self._run_c_harness("decode", packet_name, hex_bytes)
        if not ok:
            return False, {"error": output}

        # Parse DECODED: output into dict
        fields = {}
        if "DECODED:" in output:
            lines = output.split("DECODED:")[1].strip().split("\n")
            for line in lines:
                if "=" in line:
                    key, value = line.split("=", 1)
                    fields[key.strip()] = value.strip()
        return True, fields

    # =========================================================================
    # Value comparison utilities
    # =========================================================================

    def _parse_c_array(self, c_val: str) -> List[str]:
        """Parse C array output format 'v1,v2,v3' into list."""
        if not c_val:
            return []
        return [v.strip() for v in c_val.split(",")]

    def _values_match(self, c_val: str, py_val: Any, meta: FieldMeta) -> Tuple[bool, str]:
        """Compare C and Python decoded values.

        Args:
            c_val: String value from C decode output
            py_val: Python decoded value
            meta: Field metadata for comparison

        Returns:
            Tuple of (match, details_if_mismatch)
        """
        # Handle None/missing
        if c_val is None:
            return True, ""  # Field not in C output, skip

        # Handle nested struct
        if meta.is_struct and hasattr(py_val, '__dataclass_fields__'):
            # C output format: "field.subfield=value" - handled at caller level
            return True, ""

        # Handle array
        if meta.is_array:
            c_array = self._parse_c_array(c_val)
            if not isinstance(py_val, (list, tuple)):
                return False, f"Python value is not array: {type(py_val)}"
            if len(c_array) != len(py_val):
                return False, f"Array length mismatch: C={len(c_array)}, Py={len(py_val)}"
            for i, (c_elem, py_elem) in enumerate(zip(c_array, py_val)):
                if meta.is_float:
                    try:
                        c_float = float(c_elem)
                        py_float = float(py_elem)
                        if abs(c_float - py_float) > meta.tolerance:
                            return False, f"[{i}]: C={c_float} != Py={py_float} (tol={meta.tolerance})"
                    except ValueError as e:
                        return False, f"[{i}]: Parse error: {e}"
                else:
                    if str(c_elem) != str(int(py_elem)):
                        return False, f"[{i}]: C={c_elem} != Py={py_elem}"
            return True, ""

        # Handle string
        if meta.is_string:
            if str(c_val) != str(py_val):
                return False, f"C='{c_val}' != Py='{py_val}'"
            return True, ""

        # Handle float with tolerance
        if meta.is_float:
            try:
                c_float = float(c_val)
                py_float = float(py_val)
                if abs(c_float - py_float) > meta.tolerance:
                    return False, f"C={c_float} != Py={py_float} (tol={meta.tolerance})"
                return True, ""
            except ValueError as e:
                return False, f"Parse error: {e}"

        # Handle enum
        if meta.is_enum:
            try:
                c_int = int(c_val)
                py_int = int(py_val)
                if c_int != py_int:
                    return False, f"C={c_int} != Py={py_int}"
                return True, ""
            except ValueError as e:
                return False, f"Parse error: {e}"

        # Handle int/bitfield
        try:
            c_int = int(float(c_val))  # Handle "42.000000" format
            py_int = int(py_val)
            if c_int != py_int:
                return False, f"C={c_int} != Py={py_int}"
            return True, ""
        except ValueError as e:
            return False, f"Parse error: {e}"

    def _extract_field_values(self, pkt: Any) -> Dict[str, Any]:
        """Extract field values from a packet/struct as a flat dict."""
        values = {}
        if hasattr(pkt, '__dataclass_fields__'):
            for field_name in pkt.__dataclass_fields__:
                val = getattr(pkt, field_name)
                if hasattr(val, '__dataclass_fields__'):
                    # Nested struct - flatten with prefix
                    for sub_name, sub_val in self._extract_field_values(val).items():
                        values[f"{field_name}.{sub_name}"] = sub_val
                else:
                    values[field_name] = val
        return values

    def _compare_py_values(self, original: Dict[str, Any], decoded: Dict[str, Any],
                           packet_name: str) -> Tuple[bool, str]:
        """Compare original and decoded Python values for round-trip test.

        Note: Round-trip has expected quantization loss from encoding, so we use
        multiple tolerance strategies:
        1. Field-specific tolerance from metadata (based on scaling)
        2. Relative tolerance (0.1% of value)
        3. Minimum tolerance for 16-bit quantization (1/32768 ≈ 3e-5)
        """
        metadata = self.FIELD_METADATA.get(packet_name, [])
        meta_by_name = {m.name: m for m in metadata}

        # Minimum tolerance for 16-bit quantization (most common encoded type)
        MIN_TOLERANCE = 3.1e-5  # 1/32768 with margin

        mismatches = []
        for field_name, orig_val in original.items():
            if field_name not in decoded:
                continue  # Field not in decoded output

            dec_val = decoded[field_name]
            # Try to find metadata - for nested fields, try full path first, then parent
            meta = meta_by_name.get(field_name, None)
            if meta is None and '.' in field_name:
                meta = meta_by_name.get(field_name.split('.')[0], None)
            if meta is None:
                # Default metadata for unknown fields (assume float with 16-bit quantization)
                meta = FieldMeta(name=field_name, is_float=True, tolerance=MIN_TOLERANCE)

            # Array comparison (must check BEFORE float, since List[float] has is_float=True)
            if isinstance(orig_val, (list, tuple)):
                if len(orig_val) != len(dec_val):
                    mismatches.append(f"{field_name}: len {len(orig_val)} != {len(dec_val)}")
                else:
                    for i, (o, d) in enumerate(zip(orig_val, dec_val)):
                        if meta.is_float or isinstance(o, float):
                            try:
                                o_f = float(o)
                                d_f = float(d)
                                abs_diff = abs(o_f - d_f)
                                max_val = max(abs(o_f), abs(d_f), 1.0)
                                rel_tol = max_val * 0.001  # 0.1% relative
                                effective_tol = max(meta.tolerance, rel_tol, MIN_TOLERANCE)
                                if abs_diff > effective_tol:
                                    mismatches.append(f"{field_name}[{i}]: {o} != {d}")
                            except (ValueError, TypeError):
                                if o != d:
                                    mismatches.append(f"{field_name}[{i}]: {o} != {d}")
                        elif o != d:
                            mismatches.append(f"{field_name}[{i}]: {o} != {d}")
            # Scalar float comparison with tolerance (quantization expected)
            # Check both orig_val and dec_val for float type (handles int 0 -> float quantization)
            elif meta.is_float or isinstance(orig_val, float) or isinstance(dec_val, float):
                try:
                    orig_f = float(orig_val)
                    dec_f = float(dec_val)
                    abs_diff = abs(orig_f - dec_f)
                    # Use multiple tolerance strategies:
                    # 1. Field-specific tolerance from metadata
                    # 2. Relative tolerance (0.1% of larger value)
                    # 3. Minimum tolerance for 16-bit quantization
                    max_val = max(abs(orig_f), abs(dec_f), 1.0)
                    rel_tol = max_val * 0.001  # 0.1% relative
                    effective_tol = max(meta.tolerance, rel_tol, MIN_TOLERANCE)
                    if abs_diff > effective_tol:
                        mismatches.append(f"{field_name}: {orig_val} != {dec_val}")
                except (ValueError, TypeError):
                    if orig_val != dec_val:
                        mismatches.append(f"{field_name}: {orig_val} != {dec_val}")
            # Direct comparison
            elif orig_val != dec_val:
                mismatches.append(f"{field_name}: {orig_val} != {dec_val}")

        if mismatches:
            return False, "; ".join(mismatches[:5])  # Limit output
        return True, ""

