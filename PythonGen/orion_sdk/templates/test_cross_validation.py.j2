    def run_single_test(self, packet_name: str, verbose: bool = False) -> List[TestResult]:
        """Run tests for a single packet."""
        # Convert CamelCase to snake_case for method lookup
        def to_snake_case(name):
            result = []
            for i, c in enumerate(name):
                if c.isupper() and i > 0:
                    result.append('_')
                result.append(c.lower())
            return ''.join(result)

        method_name = f"test_{to_snake_case(packet_name)}"
        if hasattr(self, method_name):
            method = getattr(self, method_name)
            results = method(verbose=verbose)
            self.results = results
            return results

        raise ValueError(f"Unknown packet: {packet_name}. Use --list to see available packets.")

    def print_summary(self) -> bool:
        """Print test summary. Returns True if all passed."""
        total = len(self.results)
        passed = sum(1 for r in self.results if r.passed)
        failed = total - passed

        # Group by test type
        by_type: Dict[str, List[TestResult]] = {}
        for r in self.results:
            by_type.setdefault(r.test_type, []).append(r)

        print("\n" + "=" * 70)
        print("CROSS-LANGUAGE VALIDATION SUMMARY")
        print("=" * 70)

        all_packets = self.get_all_packet_names()
        testable = self.get_testable_packet_names()
        skipped = self.get_skipped_packet_names()

        print(f"\nPackets: {len(all_packets)} total, {len(testable)} tested, {len(skipped)} skipped")
        print(f"Tests:   {total} total, {passed} passed, {failed} failed")

        # Per-type breakdown
        print("\nBy test type:")
        for test_type in ["encode_match", "cross_c_to_py", "cross_py_to_c", "decode_values", "round_trip"]:
            if test_type in by_type:
                type_results = by_type[test_type]
                type_passed = sum(1 for r in type_results if r.passed)
                type_failed = len(type_results) - type_passed
                status = "PASS" if type_failed == 0 else "FAIL"
                print(f"  {test_type:20s}: {type_passed:3d} passed, {type_failed:3d} failed [{status}]")

        # Coverage percentage
        if all_packets:
            coverage = 100 * len(testable) / len(all_packets)
            print(f"\nPacket coverage: {coverage:.1f}%")

        print()

        if failed > 0:
            print("FAILURES:")
            print("-" * 70)
            for r in self.results:
                if not r.passed:
                    print(f"  [{r.packet_name}] {r.test_type}")
                    print(f"    {r.details}")
                    if r.c_output and len(r.c_output) < 100:
                        print(f"    C output:  {r.c_output}")
                    if r.py_output and len(r.py_output) < 100:
                        print(f"    Py output: {r.py_output}")
            print()

        return failed == 0

    def print_coverage_report(self):
        """Print detailed packet coverage report."""
        all_packets = self.get_all_packet_names()
        testable = self.get_testable_packet_names()
        skipped = self.get_skipped_packet_names()

        print("\n" + "=" * 70)
        print("PACKET COVERAGE REPORT")
        print("=" * 70)

        print(f"\nTotal packets defined: {len(all_packets)}")
        print(f"Packets with C implementation: {len(testable)}")
        print(f"Packets without C implementation: {len(skipped)}")

        if all_packets:
            coverage = 100 * len(testable) / len(all_packets)
            print(f"\nCoverage: {coverage:.1f}%")

        if skipped:
            print(f"\nSkipped packets (no C implementation):")
            for name in sorted(skipped):
                print(f"  - {name}")

        if testable:
            print(f"\nTested packets:")
            for name in sorted(testable):
                print(f"  + {name}")


def main():
    parser = argparse.ArgumentParser(
        description="Cross-language encode/decode validation for {{ protocol.name }}"
    )
    parser.add_argument(
        "--harness",
        default="./test_harness",
        help="Path to C test harness executable"
    )
    parser.add_argument(
        "--packet",
        help="Test specific packet only (case-insensitive)"
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List all available packets"
    )
    parser.add_argument(
        "--coverage",
        action="store_true",
        help="Print detailed coverage report"
    )
    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Verbose output"
    )
    args = parser.parse_args()

    try:
        validator = CrossLanguageValidator(args.harness)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    if args.list:
        print("Available packets:")
        for name in validator.get_all_packet_names():
            has_c = name in validator.get_testable_packet_names()
            status = "[C]" if has_c else "[no C]"
            print(f"  {name} {status}")
        return 0

    if args.coverage:
        validator.print_coverage_report()
        return 0

    if args.packet:
        # Test specific packet
        try:
            validator.run_single_test(args.packet, verbose=args.verbose)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            return 1
    else:
        # Test all packets
        validator.run_all_tests(verbose=args.verbose)

    success = validator.print_summary()
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
