@dataclass
class TestResult:
    """Result of a single test."""
    packet_name: str
    test_type: str  # 'encode_match', 'decode_values', 'round_trip', 'edge_case_*'
    passed: bool
    details: str = ""
    c_output: str = ""
    py_output: str = ""


@dataclass
class FieldMeta:
    """Metadata for field value comparison."""
    name: str
    type_hint: str = "Any"
    is_float: bool = False
    is_array: bool = False
    is_struct: bool = False
    is_enum: bool = False
    is_string: bool = False
    is_bitfield: bool = False
    struct_ref: Optional[str] = None
    enum_ref: Optional[str] = None
    array_length: Optional[int] = None
    variable_array: Optional[str] = None
    in_c_struct: bool = True
    tolerance: float = 1e-6


