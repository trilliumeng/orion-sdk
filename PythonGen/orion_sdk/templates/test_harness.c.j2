/* Helper: print bytes as hex string */
static void print_hex(const uint8_t *data, int len) {
    for (int i = 0; i < len; i++) {
        printf("%02X", data[i]);
    }
}

/* Helper: parse hex string to bytes */
static int parse_hex(const char *hex, uint8_t *out, int max_len) {
    int len = 0;
    while (*hex && len < max_len) {
        if (!isxdigit(hex[0]) || !isxdigit(hex[1])) {
            hex++;
            continue;
        }
        unsigned int byte;
        sscanf(hex, "%2x", &byte);
        out[len++] = (uint8_t)byte;
        hex += 2;
    }
    return len;
}

