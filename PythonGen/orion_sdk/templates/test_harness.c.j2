/*============================================================================
 * MAIN - Command dispatch
 *============================================================================*/

typedef void (*encode_fn)(void);
typedef void (*decode_fn)(const uint8_t*, int);

typedef struct {
    const char *name;
    encode_fn encode;
    decode_fn decode;
} PacketHandler;

static const PacketHandler handlers[] = {
{% for pkt_info in packets_info %}
{% if pkt_info.has_c_impl %}
    { "{{ pkt_info.packet.name }}", encode_{{ pkt_info.packet.name }}, decode_{{ pkt_info.packet.name }} },
{% endif %}
{% endfor %}
    { NULL, NULL, NULL }
};

static void print_usage(const char *prog) {
    fprintf(stderr, "Cross-language test harness for {{ protocol.name }} v{{ protocol.version }}\n\n");
    fprintf(stderr, "Usage:\n");
    fprintf(stderr, "  %s encode <PacketName>              Encode packet with test values\n", prog);
    fprintf(stderr, "  %s decode <PacketName> <hex_bytes>  Decode hex bytes\n", prog);
    fprintf(stderr, "  %s list                             List all packets\n", prog);
}

static void list_packets(void) {
    int count = 0;
    for (int i = 0; handlers[i].name; i++) count++;
    printf("Available packets (%d total):\n", count);
    for (int i = 0; handlers[i].name; i++) {
        printf("  %s\n", handlers[i].name);
    }
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        print_usage(argv[0]);
        return 1;
    }

    if (strcmp(argv[1], "list") == 0) {
        list_packets();
        return 0;
    }

    if (argc < 3) {
        print_usage(argv[0]);
        return 1;
    }

    const char *cmd = argv[1];
    const char *packet_name = argv[2];

    /* Find handler */
    const PacketHandler *handler = NULL;
    for (int i = 0; handlers[i].name; i++) {
        if (strcmp(handlers[i].name, packet_name) == 0) {
            handler = &handlers[i];
            break;
        }
    }

    if (!handler) {
        fprintf(stderr, "Unknown packet: %s\n", packet_name);
        fprintf(stderr, "Use '%s list' to see available packets\n", argv[0]);
        return 1;
    }

    if (strcmp(cmd, "encode") == 0) {
        handler->encode();
    } else if (strcmp(cmd, "decode") == 0) {
        if (argc < 4) {
            fprintf(stderr, "decode requires hex_bytes argument\n");
            return 1;
        }
        uint8_t buffer[2048];
        int len = parse_hex(argv[3], buffer, sizeof(buffer));
        handler->decode(buffer, len);
    } else {
        fprintf(stderr, "Unknown command: %s\n", cmd);
        print_usage(argv[0]);
        return 1;
    }

    return 0;
}
